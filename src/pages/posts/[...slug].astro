---
import { getEntry, render } from 'astro:content';
import { site } from 'virtual:astro-tufte/config';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { slug: id } = Astro.params;

if (!id) {
  return Astro.redirect('/404');
}

const post = await getEntry('posts', id);

if (!post || post.data.draft) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} math={post.data.math}>
  <header class="post-header">
    <h1>{post.data.title}</h1>
    {post.data.subtitle && <p class="post-subtitle">{post.data.subtitle}</p>}
    <p class="post-meta">
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString(site.locale, {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    </p>
    {post.data.tags && (
      <div class="post-tags">
        {post.data.tags.map((tag: string) => <span class="post-tag">#{tag}</span>)}
      </div>
    )}
  </header>

  <div class="prose prose-lg max-w-none">
    <Content />
  </div>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 3rem;
  }

  .post-header h1 {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .post-subtitle {
    font-family: var(--font-serif-italic);
    font-style: italic;
    font-size: 1.25rem;
    color: #555;
    margin: 0.25rem 0 0;
  }

  .post-meta {
    color: #666;
    margin: 0.5rem 0 0;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .post-tag {
    font-size: 0.875rem;
    color: #888;
  }
</style>
