---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={["fullwidth", className]}>
  <slot />
</div>

<style>
  .fullwidth {
    max-width: none;
    clear: both;
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }

  /* Clear any floats before fullwidth */
  .fullwidth::before {
    content: "";
    display: table;
    clear: both;
  }

  .fullwidth :global(figure) {
    margin: 0;
  }

  .fullwidth :global(img) {
    width: 100%;
    height: auto;
  }

  .fullwidth :global(figcaption) {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: #666;
    text-align: center;
  }

  /* Span the container's content box exactly. The article's content box shares its
     LEFT edge with the container's (only its right side is padded for margin notes),
     so margin-left stays 0 and we just set the width. The container's percentage
     padding resolves against the viewport, not its own max-width -- hence the vw. */
  @media (min-width: 768px) {
    .fullwidth {
      width: 92vw;                  /* container 100vw, padding 4% */
      margin-left: 0;
    }
  }

  @media (min-width: 900px) {
    .fullwidth {
      width: calc(900px - 8vw);     /* container 900px, padding 4% of 100vw */
    }
  }

  @media (min-width: 1024px) {
    .fullwidth {
      width: calc(1000px - 8vw);    /* container 1000px, padding 4% of 100vw */
    }
  }

  @media (min-width: 1400px) {
    .fullwidth {
      width: 1000px;                /* container 1100px - 2x50px */
    }
  }
</style>
