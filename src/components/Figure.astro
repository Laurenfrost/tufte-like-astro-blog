---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  fullwidth?: boolean;
  /** 出血：突破 tufte-container，向视口两侧扩展，比 fullwidth 更宽 */
  bleed?: boolean;
}

const { src, alt, caption, credit, fullwidth = false, bleed = false } = Astro.props;

// bleed 与 fullwidth 共用「图下居中说明」的排版
const belowCaption = fullwidth || bleed;
---

<figure class:list={["tufte-figure", { fullwidth, bleed }]}>
  {(caption || credit) && !belowCaption && (
    <figcaption class="margin-caption">
      {caption}<span class="credit">{credit && (caption ? `, ${credit}` : credit)}</span>
    </figcaption>
  )}
  <img src={src} alt={alt} loading="lazy" />
  {(caption || credit) && belowCaption && (
    <figcaption class="below-caption">
      {caption}<span class="credit">{credit && (caption ? `, ${credit}` : credit)}</span>
    </figcaption>
  )}
</figure>

<style>
  .tufte-figure {
    margin: 2rem 0;
    padding: 0;
    position: relative;
  }

  .tufte-figure img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .tufte-figure .credit {
    color: #777;
  }

  /* Margin caption: floats to right margin, aligns with image top */
  .tufte-figure .margin-caption {
    font-size: 0.8rem;
    line-height: 1.5;
    color: #555;
  }

  @media (min-width: 768px) {
    .tufte-figure .margin-caption {
      float: right;
      clear: right;
      margin-right: -38%;
      width: 33%;
      margin-top: 0;
      margin-bottom: 0;
    }
  }

  @media (min-width: 1024px) {
    .tufte-figure .margin-caption {
      margin-right: -42%;
      width: 36%;
    }
  }

  /* Wide screens: fixed values */
  @media (min-width: 1400px) {
    .tufte-figure .margin-caption {
      margin-right: -420px;
      width: 380px;
    }
  }

  /* Mobile: margin caption below image */
  @media (max-width: 767px) {
    .tufte-figure .margin-caption {
      display: block;
      order: 1;
      margin-top: 0.5rem;
    }

    .tufte-figure {
      display: flex;
      flex-direction: column;
    }

    .tufte-figure img {
      order: 0;
    }
  }

  /* Below caption: for fullwidth figures */
  .tufte-figure .below-caption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #555;
  }

  /* Fullwidth figure: spans the container's content box exactly.
     The article's content box shares its LEFT edge with the container's (only its
     right side is padded for margin notes), so margin-left stays 0 and we just set
     the width. The container's percentage padding resolves against the viewport,
     not against its own max-width -- hence the vw terms. */
  .tufte-figure.fullwidth {
    max-width: none;
    clear: both;
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
    display: block;
  }

  /* Clear any floats before fullwidth */
  .tufte-figure.fullwidth::before {
    content: "";
    display: table;
    clear: both;
  }

  @media (min-width: 768px) {
    .tufte-figure.fullwidth {
      width: 92vw;                        /* container 100vw, padding 4% */
      margin-left: 0;
    }
  }

  @media (min-width: 900px) {
    .tufte-figure.fullwidth {
      width: calc(900px - 8vw);           /* container 900px, padding 4% of 100vw */
    }
  }

  @media (min-width: 1024px) {
    .tufte-figure.fullwidth {
      width: calc(1000px - 8vw);          /* container 1000px, padding 4% of 100vw */
    }
  }

  @media (min-width: 1400px) {
    .tufte-figure.fullwidth {
      width: 1000px;                      /* container 1100px - 2x50px */
    }
  }

  /* Bleed figure: escapes .tufte-container entirely and spans the viewport.
     For diagrams that need more room than the container allows.

     The article's content box is NOT centred in the viewport (its right side is
     reserved for margin notes), so the usual `50% - 50vw` trick lands off-centre.
     Its LEFT edge does coincide with the container's content box, so we centre
     against that instead: margin-left = (container content width - 100vw) / 2.
     NB the container's percentage padding resolves against the viewport, not
     against its own max-width -- hence the 54vw terms below. */
  .tufte-figure.bleed {
    max-width: none;
    clear: both;
    display: block;
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
    width: 100vw;
    padding: 0 1rem;
    margin-left: -5vw;                    /* < 768px: container 100vw, padding 5% */
  }

  .tufte-figure.bleed::before {
    content: "";
    display: table;
    clear: both;
  }

  /* Cap the image so ultrawide screens don't blow the diagram up */
  .tufte-figure.bleed img {
    max-width: min(100%, 1400px);
    margin-left: auto;
    margin-right: auto;
  }

  .tufte-figure.bleed .below-caption {
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 768px) {
    .tufte-figure.bleed {
      padding: 0 2rem;
      margin-left: -4vw;                  /* container 100vw, padding 4% */
    }
  }

  @media (min-width: 900px) and (max-width: 1023px) {
    .tufte-figure.bleed {
      margin-left: calc(450px - 54vw);    /* container 900px, padding 4% of 100vw */
    }
  }

  @media (min-width: 1024px) and (max-width: 1399px) {
    .tufte-figure.bleed {
      margin-left: calc(500px - 54vw);    /* container 1000px, padding 4% of 100vw */
    }
  }

  @media (min-width: 1400px) {
    .tufte-figure.bleed {
      margin-left: calc(500px - 50vw);    /* container 1100px - 2x50px => 1000px */
    }
  }
</style>
