{
  "name": "@laurenfrost/astro-tufte",
  "version": "0.2.0",
  "type": "module",
  "description": "Tufte-inspired Astro theme with sidenotes, margin notes and CJK-aware typography",
  "keywords": [
    "astro-integration",
    "astro-component",
    "astro-theme",
    "withastro",
    "tufte",
    "typography"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Laurenfrost/tufte-like-astro-blog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laurenfrost/tufte-like-astro-blog.git"
  },
  "exports": {
    ".": "./integration.mjs",
    "./schema": "./src/schema.mjs",
    "./theme.css": "./src/styles/theme.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./components/*.astro": "./src/components/*.astro",
    "./layouts/*.astro": "./src/layouts/*.astro",
    "./pages/*.astro": "./src/pages/*.astro",
    "./package.json": "./package.json"
  },
  "files": [
    "integration.mjs",
    "src",
    "worker",
    "virtual.d.ts"
  ],
  "types": "./virtual.d.ts",
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev": "npm run dev -w playground",
    "build": "npm run build -w playground",
    "preview": "npm run preview -w playground",
    "deploy:worker": "cd worker && npx wrangler deploy"
  },
  "peerDependencies": {
    "astro": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@shikijs/transformers": "^3.22.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "astro": "^5.17.1"
  }
}
