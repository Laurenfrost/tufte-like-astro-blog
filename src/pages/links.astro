---
import { site } from 'virtual:astro-tufte/config';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={site.text.linksTitle} wide>
  <h1>{site.text.linksTitle}</h1>
  {site.text.linksIntro && <p class="links-intro">{site.text.linksIntro}</p>}

  <ul class="links-list">
    {site.links.map(link => (
      <li class="link-item">
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-name">
          {link.name}
        </a>
        {link.description && <p class="link-desc">{link.description}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }

  .links-intro {
    color: #666;
    margin-bottom: 2rem;
  }

  .links-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .link-item {
    padding: 1rem 0;
    border-bottom: 1px solid #eee;
  }

  .link-item:last-child {
    border-bottom: none;
  }

  .link-name {
    font-size: 1.1rem;
  }

  .link-desc {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    color: #666;
  }
</style>
